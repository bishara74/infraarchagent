# Copy to .env and replace the local development passwords.
POSTGRES_PASSWORD=replace-with-local-superuser-password
INFRAARCH_OWNER_PASSWORD=replace-with-local-owner-password
INFRAARCH_APP_PASSWORD=replace-with-local-app-password
DATABASE_URL=postgresql+asyncpg://infraarch_app:replace-with-local-app-password@localhost:5432/infraarch
MIGRATION_DATABASE_URL=postgresql+asyncpg://infraarch_owner:replace-with-local-owner-password@localhost:5432/infraarch
TEST_DATABASE_URL=postgresql+asyncpg://infraarch_app:replace-with-local-app-password@localhost:5432/infraarch_test
TEST_MIGRATION_DATABASE_URL=postgresql+asyncpg://infraarch_owner:replace-with-local-owner-password@localhost:5432/infraarch_test
LLM_PROVIDER=stub
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=
LLM_REASONING_EFFORT=
LLM_RESPONSE_FORMAT=
BROKER_QUEUE_SIZE=1000
MAX_CONCURRENT_RUNS=5
SSE_KEEPALIVE_SECONDS=15
LLM_ATTEMPT_TIMEOUT_SECONDS=30
LLM_MAX_ATTEMPTS=3
LLM_DEADLINE_SECONDS=150
AGENT_DEADLINE_SECONDS=150
ARCHITECT_MAX_PLAN_ATTEMPTS=3
GENERATOR_DEADLINE_SECONDS=150
GENERATOR_ATTEMPT_TIMEOUT_SECONDS=120
GENERATOR_MAX_OUTPUT_TOKENS=32000
GENERATOR_MAX_PACKAGE_ATTEMPTS=2
LLM_BACKOFF_BASE_SECONDS=1.0
LLM_MAX_OUTPUT_TOKENS=16000
MAX_REMEDIATION_ITERATIONS=3
SECURITY_DEADLINE_SECONDS=240
SCANNER_TIMEOUT_SECONDS=120
FIX_ATTEMPT_TIMEOUT_SECONDS=90
FIX_MAX_OUTPUT_TOKENS=16000
SECURITY_MAX_PARALLEL_FIXES=4
PACKAGE_RETENTION_DAYS=30
LOG_LEVEL=INFO
