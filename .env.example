# Copy to .env and replace the local development passwords.
POSTGRES_PASSWORD=replace-with-local-superuser-password
INFRAARCH_OWNER_PASSWORD=replace-with-local-owner-password
INFRAARCH_APP_PASSWORD=replace-with-local-app-password
DATABASE_URL=postgresql+asyncpg://infraarch_app:replace-with-local-app-password@localhost:5432/infraarch
MIGRATION_DATABASE_URL=postgresql+asyncpg://infraarch_owner:replace-with-local-owner-password@localhost:5432/infraarch
TEST_DATABASE_URL=postgresql+asyncpg://infraarch_app:replace-with-local-app-password@localhost:5432/infraarch_test
TEST_MIGRATION_DATABASE_URL=postgresql+asyncpg://infraarch_owner:replace-with-local-owner-password@localhost:5432/infraarch_test
LLM_PROVIDER=stub
# Test/demo aid only; affects stub runs, never real providers.
PIPELINE_DEMO_SCENARIO=clean
LLM_MODEL=
LLM_API_KEY=
# Optional pipeline authentication; benchmarks require a matching configured key.
API_KEY=
# Curated lessons require this server gate AND the admin runtime switch.
LESSONS_ENABLED=false
# Keep four-eyes approval unless explicitly opting into single-operator review.
LESSONS_ADMIN_DIRECT_ACTIVATION=true
LLM_BASE_URL=
LLM_REASONING_EFFORT=
LLM_RESPONSE_FORMAT=
# Generator/Fixer output format; explicit model choices require compatible capabilities.
# Legacy environment requests retain their existing adapter behavior.
LLM_STRUCTURED_OUTPUT=json_schema
SECURITY_FIX_PROVIDER=
SECURITY_FIX_MODEL=
SECURITY_FIX_REASONING_EFFORT=
BROKER_QUEUE_SIZE=1000
MAX_CONCURRENT_RUNS=5
SSE_KEEPALIVE_SECONDS=15
LLM_ATTEMPT_TIMEOUT_SECONDS=30
LLM_MAX_ATTEMPTS=3
LLM_DEADLINE_SECONDS=150
AGENT_DEADLINE_SECONDS=150
ARCHITECT_MAX_PLAN_ATTEMPTS=3
GENERATOR_DEADLINE_SECONDS=150
GENERATOR_ATTEMPT_TIMEOUT_SECONDS=120
# About 60 seconds at the observed ~140 output tokens/second; generator-only.
GENERATOR_MAX_OUTPUT_TOKENS=8000
GENERATOR_MAX_PACKAGE_ATTEMPTS=3
LLM_BACKOFF_BASE_SECONDS=1.0
LLM_MAX_OUTPUT_TOKENS=16000
MAX_REMEDIATION_ITERATIONS=4
SECURITY_DEADLINE_SECONDS=240
SCANNER_TIMEOUT_SECONDS=120
FIX_ATTEMPT_TIMEOUT_SECONDS=90
FIX_MAX_OUTPUT_TOKENS=16000
SECURITY_MAX_PARALLEL_FIXES=4
PACKAGE_RETENTION_DAYS=30
LOG_LEVEL=INFO
# Optional redacted app.llm.base diagnostics only; parent directory must exist.
# Relative paths resolve against the repository root. Keep generated files untracked.
LOG_FILE=

# Optional explicit system-message caching for compatible Anthropic models
LLM_PROMPT_CACHE=off
VALIDATOR_TOOL_TIMEOUT_SECONDS=60
VALIDATOR_MAX_PARALLEL_TOOLS=3
VALIDATION_DEADLINE_SECONDS=120
# Automatic pre-security rounds; at most one extra post-security round.
VALIDATION_REPAIR_MAX_ROUNDS=2

# Phase 9e: bounded offline schema grounding and independent post-security repair.
SCHEMA_CONTEXT_MAX_CHARS=16000
POST_SECURITY_REPAIR_DEADLINE_SECONDS=60

# Optional local inspection tools. Author pulls the pinned pgAdmin image.
INFRAARCH_READONLY_PASSWORD=replace-with-local-readonly-password
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=replace-with-local-pgadmin-password
# Export CREDENTIAL_ENCRYPTION_KEY and CREDENTIAL_ENCRYPTION_KEY_VERSION in the
# backend process environment; dotenv is not a source for the encryption key.
