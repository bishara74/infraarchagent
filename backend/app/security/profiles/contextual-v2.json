{
  "id": "contextual-v2",
  "version": 2,
  "base_policy_version": "3",
  "approval": "experimental; supervisor approval required before reported use",
  "entries": [
    {
      "id": "s3-log-target-sse-s3",
      "checkov_ids": [
        "CKV_AWS_145"
      ],
      "trivy_ids": [
        "AWS-0132"
      ],
      "resource_types": [
        "aws_s3_bucket",
        "aws_s3_bucket_server_side_encryption_configuration"
      ],
      "condition": "log_target_encryption",
      "justification": "A proven S3 access-log destination uses SSE-S3 for log delivery compatibility.",
      "references": [
        "https://docs.aws.amazon.com/AmazonS3/latest/userguide/enable-server-access-logging.html"
      ]
    },
    {
      "id": "s3-log-target-no-recursion",
      "checkov_ids": [
        "CKV_AWS_18"
      ],
      "trivy_ids": [
        "AWS-0089"
      ],
      "resource_types": [
        "aws_s3_bucket"
      ],
      "condition": "log_target",
      "justification": "Logging a proven log destination recursively is not required by this contextual view.",
      "references": [
        "https://docs.aws.amazon.com/AmazonS3/latest/userguide/ServerLogs.html"
      ]
    },
    {
      "id": "public-subnet-addressing",
      "checkov_ids": [
        "CKV_AWS_130"
      ],
      "trivy_ids": [
        "AWS-0164"
      ],
      "resource_types": [
        "aws_subnet"
      ],
      "condition": "public_subnet",
      "justification": "Bounded literal/local subnet instances have a unique default IGW route in the same resolved VPC.",
      "references": [
        "https://docs.aws.amazon.com/vpc/latest/userguide/VPC_Internet_Gateway.html"
      ]
    },
    {
      "id": "public-lb-exclusive-egress",
      "checkov_ids": [],
      "trivy_ids": [
        "AWS-0104"
      ],
      "resource_types": [
        "aws_security_group",
        "aws_security_group_rule",
        "aws_vpc_security_group_egress_rule"
      ],
      "condition": "public_lb_egress",
      "justification": "Only security groups proven exclusively attached to explicitly public application load balancers qualify.",
      "references": [
        "https://docs.aws.amazon.com/elasticloadbalancing/latest/application/load-balancer-update-security-groups.html"
      ]
    },
    {
      "id": "public-lb-https-redirect",
      "checkov_ids": [],
      "trivy_ids": [
        "AWS-0053"
      ],
      "resource_types": [
        "aws_lb",
        "aws_alb"
      ],
      "condition": "public_lb_redirect",
      "justification": "Public ALB listeners use HTTPS with optional redirect-only HTTP; public NLB listeners use only explicit TLS 1.2+ policies.",
      "references": [
        "https://docs.aws.amazon.com/elasticloadbalancing/latest/application/rule-action-types.html"
      ]
    },
    {
      "id": "public-lb-http-ingress",
      "checkov_ids": [
        "CKV_AWS_260"
      ],
      "trivy_ids": [],
      "resource_types": [
        "aws_security_group",
        "aws_security_group_rule",
        "aws_vpc_security_group_ingress_rule"
      ],
      "condition": "public_lb_http",
      "justification": "Exact TCP port-80 ingress belongs exclusively to public load balancers whose HTTP listeners redirect to HTTPS.",
      "references": [
        "https://docs.aws.amazon.com/elasticloadbalancing/latest/application/rule-action-types.html"
      ]
    }
  ],
  "nlb_tls12_policies": [
    "ELBSecurityPolicy-TLS13-1-3-2021-06",
    "ELBSecurityPolicy-TLS13-1-3-PQ-2025-09",
    "ELBSecurityPolicy-TLS13-1-2-2021-06",
    "ELBSecurityPolicy-TLS13-1-2-PQ-2025-09",
    "ELBSecurityPolicy-TLS13-1-2-Res-2021-06",
    "ELBSecurityPolicy-TLS13-1-2-Res-PQ-2025-09",
    "ELBSecurityPolicy-TLS13-1-2-Ext1-2021-06",
    "ELBSecurityPolicy-TLS13-1-2-Ext1-PQ-2025-09",
    "ELBSecurityPolicy-TLS13-1-2-Ext2-2021-06",
    "ELBSecurityPolicy-TLS13-1-2-Ext2-PQ-2025-09",
    "ELBSecurityPolicy-TLS-1-2-Ext-2018-06",
    "ELBSecurityPolicy-TLS-1-2-2017-01"
  ],
  "tls_policy_reference": "https://docs.aws.amazon.com/elasticloadbalancing/latest/network/describe-ssl-policies.html"
}
