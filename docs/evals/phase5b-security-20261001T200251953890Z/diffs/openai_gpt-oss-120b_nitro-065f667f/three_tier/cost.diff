+# VPC with flow logs enabled and default SG restrictive
 resource "aws_vpc" "main" {
   cidr_block           = "10.0.0.0/16"
   enable_dns_hostnames = true
   tags = local.common_tags
 }
 
+resource "aws_default_security_group" "default" {
+  vpc_id = aws_vpc.main.id
+  # Revoke the default inbound rule that allows all traffic
+  revoke_rules = [{
+    from_port   = 0
+    to_port     = 0
+    protocol    = "-1"
+    cidr_blocks = ["0.0.0.0/0"]
+  }]
+  # Revoke the default outbound rule that allows all traffic
+  revoke_rules_egress = [{
+    from_port   = 0
+    to_port     = 0
+    protocol    = "-1"
+    cidr_blocks = ["0.0.0.0/0"]
+  }]
+  tags = local.common_tags
+}
+
+resource "aws_flow_log" "vpc_flow" {
+  iam_role_arn    = aws_iam_role.flow_log_role.arn
+  log_group_name  = "/aws/vpc/flow-logs"
+  vpc_id          = aws_vpc.main.id
+  traffic_type    = "ALL"
+}
+
+resource "aws_iam_role" "flow_log_role" {
+  name = "vpcFlowLogRole"
+  assume_role_policy = jsonencode({
+    Version = "2012-10-17",
+    Statement = [{
+      Effect = "Allow",
+      Principal = { Service = "vpc-flow-logs.amazonaws.com" },
+      Action = "sts:AssumeRole"
+    }]
+  })
+}
+
+resource "aws_iam_role_policy_attachment" "flow_log_attach" {
+  role       = aws_iam_role.flow_log_role.name
+  policy_arn = "arn:aws:iam::aws:policy/service-role/AmazonVPCCrossAccountNetworkLogging"
+}
+
