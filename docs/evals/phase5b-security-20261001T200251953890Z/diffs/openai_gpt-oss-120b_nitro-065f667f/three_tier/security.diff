+
+resource "aws_s3_bucket_logging" "static_assets_logging" {
+  bucket = aws_s3_bucket.static_assets.id
+  target_bucket = aws_s3_bucket.static_assets.id
+  target_prefix = "access-logs/"
+}
+
+# Cross‑region replication (destination bucket must exist in another region)
+resource "aws_s3_bucket_replication_configuration" "static_assets_replication" {
+  bucket = aws_s3_bucket.static_assets.id
+  role   = aws_iam_role.replication_role.arn
+  rules {
+    id       = "replicate-to-destination"
+    status   = "Enabled"
+    priority = 1
+    filter {}
+    destination {
+      bucket        = var.replication_destination_bucket_arn
+      storage_class = "STANDARD"
+      # Encryption with same KMS key in destination region
+      encryption_configuration {
+        replica_kms_key_id = var.kms_key_arn
+      }
+    }
+  }
+}
+
+resource "aws_iam_role" "replication_role" {
+  name = "s3-replication-role"
+  assume_role_policy = jsonencode({
+    Version = "2012-10-17",
+    Statement = [{
+      Effect = "Allow",
+      Principal = { Service = "s3.amazonaws.com" },
+      Action = "sts:AssumeRole"
+    }]
+  })
+}
+
+resource "aws_iam_role_policy" "replication_policy" {
+  name = "s3-replication-policy"
+  role = aws_iam_role.replication_role.id
+  policy = jsonencode({
+    Version = "2012-10-17",
+    Statement = [{
+      Effect = "Allow",
+      Action = [
+        "s3:GetObjectVersion",
+        "s3:GetObjectVersionAcl",
+        "s3:GetObjectVersionTagging",
+        "s3:ReplicateObject",
+        "s3:ReplicateDelete",
+        "s3:ReplicateTags"
+      ],
+      Resource = "${aws_s3_bucket.static_assets.arn}/*"
+    },
+    {
+      Effect = "Allow",
+      Action = [
+        "s3:ListBucket",
+        "s3:GetBucketVersioning"
+      ],
+      Resource = aws_s3_bucket.static_assets.arn
+    }]
+  })
+}
