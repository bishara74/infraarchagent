+
+# Replication destination bucket (cross‑region)
+resource "aws_s3_bucket" "logs_replica" {
+  bucket = "${var.cluster_name}-logs-replica-${random_id.bucket_suffix.hex}"
+  force_destroy = true
+  provider = aws.us_east_1  # Example of different region
+  versioning {
+    enabled = true
+  }
+  server_side_encryption_configuration {
+    rule {
+      apply_server_side_encryption_by_default {
+        kms_master_key_id = aws_kms_key.master.arn
+        sse_algorithm     = "aws:kms"
+      }
+    }
+  }
+  tags = { Name = "${var.cluster_name}-logs-replica" }
+}
+
+resource "aws_s3_bucket_public_access_block" "logs_replica_block" {
+  bucket = aws_s3_bucket.logs_replica.id
+  block_public_acls   = true
+  block_public_policy = true
+  ignore_public_acls  = true
+  restrict_public_buckets = true
+}
+
+resource "random_id" "bucket_suffix" {
+  byte_length = 4
+}
+
+resource "aws_iam_role" "s3_replication_role" {
+  name = "${var.cluster_name}-s3-repl-role"
+  assume_role_policy = jsonencode({
+    Version = "2012-10-17",
+    Statement = [{
+      Effect = "Allow",
+      Principal = { Service = "s3.amazonaws.com" },
+      Action = "sts:AssumeRole"
+    }]
+  })
+}
+
+resource "aws_iam_policy" "s3_replication_policy" {
+  name = "${var.cluster_name}-s3-repl-policy"
+  policy = jsonencode({
+    Version = "2012-10-17",
+    Statement = [{
+      Effect = "Allow",
+      Action = [
+        "s3:GetObjectVersion",
+        "s3:GetObjectVersionAcl",
+        "s3:GetObjectVersionTagging",
+        "s3:ReplicateObject",
+        "s3:ReplicateDelete",
+        "s3:ReplicateTags"
+      ],
+      Resource = [
+        "arn:aws:s3:::${var.cluster_name}-logs-${random_id.bucket_suffix.hex}/*",
+        "arn:aws:s3:::${var.cluster_name}-logs-replica-${random_id.bucket_suffix.hex}/*"
+      ]
+    }]
+  })
+}
+
+resource "aws_iam_role_policy_attachment" "s3_replication_attach" {
+  role       = aws_iam_role.s3_replication_role.name
+  policy_arn = aws_iam_policy.s3_replication_policy.arn
 }
 
