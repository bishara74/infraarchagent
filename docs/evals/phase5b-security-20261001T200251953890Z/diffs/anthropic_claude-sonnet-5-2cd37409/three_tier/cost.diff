-resource "aws_lb_listener" "http" {
+# HTTPS listener (TLS 1.2 minimum)
+resource "aws_lb_listener" "https" {
   load_balancer_arn = aws_lb.alb.arn
-  port              = 80
-  protocol          = "HTTP"
+  port              = 443
+  protocol          = "HTTPS"
+  ssl_policy        = "ELBSecurityPolicy-TLS-1-2-2017-01"
+  certificate_arn   = var.acm_certificate_arn
 
   default_action {
     type             = "forward"
@@ -56,8 +69,24 @@
   }
 }
 
+# HTTP listener that redirects to HTTPS
+resource "aws_lb_listener" "http" {
+  load_balancer_arn = aws_lb.alb.arn
+  port              = 80
+  protocol          = "HTTP"
+
+  default_action {
+    type = "redirect"
+    redirect {
+      protocol    = "HTTPS"
+      port        = "443"
+      status_code = "HTTP_301"
+    }
+  }
+}
+
 resource "aws_lb_listener_rule" "app_service_2" {
-  listener_arn = aws_lb_listener.http.arn
+  listener_arn = aws_lb_listener.https.arn
   priority     = 10
 
   action {
@@ -71,3 +100,54 @@
     }
   }
 }
+
+# KMS key for S3 bucket encryption (Free Tier eligible)
+resource "aws_kms_key" "alb_logs" {
+  description         = "KMS key for ALB logs bucket encryption"
+  deletion_window_in_days = 7
+  enable_key_rotation = true
+}
+
+# S3 bucket for ALB access logs (Free Tier eligible)
+resource "aws_s3_bucket" "alb_logs" {
+  bucket = "${var.project_name}-alb-logs"
+  acl    = "private"
+
+  versioning {
+    enabled = true
+  }
+
+  server_side_encryption_configuration {
+    rule {
+      apply_server_side_encryption_by_default {
+        sse_algorithm   = "aws:kms"
+        kms_master_key_id = aws_kms_key.alb_logs.arn
+      }
+    }
+  }
+
+  # Enable S3 bucket access logging (logs to the same bucket with a distinct prefix)
+  logging {
+    target_bucket = aws_s3_bucket.alb_logs.id
+    target_prefix = "bucket-logs/"
+  }
+
+  lifecycle_rule {
+    enabled = true
+    expiration {
+      days = 365
+    }
+  }
+
+  tags = {
+    Name = "alb-logs"
+  }
+}
+
+resource "aws_s3_bucket_public_access_block" "alb_logs" {
+  bucket = aws_s3_bucket.alb_logs.id
+  block_public_acls   = true
+  block_public_policy = true
+  ignore_public_acls  = true
+  restrict_public_buckets = true
+}
--- a/terraform/network.tf
+++ b/terraform/network.tf
@@ -4,6 +4,18 @@
   enable_dns_support   = true
   enable_dns_hostnames = true
   tags = { Name = "${var.project_name}-vpc" }
+}
+
+# Restrict the default security group (no inbound or outbound traffic)
+resource "aws_default_security_group" "default" {
+  vpc_id = aws_vpc.main.id
+
+  revoke_rules_on_delete = true
+
+  ingress {}
+  egress  {}
+
+  tags = { Name = "${var.project_name}-default-sg" }
 }
 
 resource "aws_internet_gateway" "igw" {
@@ -15,7 +27,8 @@
   vpc_id                  = aws_vpc.main.id
   cidr_block              = var.public_subnet_cidr
   availability_zone       = var.availability_zone
-  map_public_ip_on_launch = true
+  # Do not assign public IPs by default (cost & security)
+  map_public_ip_on_launch = false
   tags = { Name = "${var.project_name}-public-subnet" }
 }
 
@@ -81,3 +94,33 @@
   route_table_ids = [aws_route_table.private.id, aws_route_table.public.id]
   tags = { Name = "${var.project_name}-s3-endpoint" }
 }
+
+# VPC Flow Log for visibility (free tier compatible)
+resource "aws_cloudwatch_log_group" "vpc_flow_log" {
+  name              = "/aws/vpc/flow-logs/${var.project_name}"
+  retention_in_days = 7
+}
+
+resource "aws_flow_log" "vpc" {
+  log_group_name = aws_cloudwatch_log_group.vpc_flow_log.name
+  traffic_type   = "ALL"
+  vpc_id         = aws_vpc.main.id
+  iam_role_arn   = aws_iam_role.flow_log_role.arn
+}
+
+resource "aws_iam_role" "flow_log_role" {
+  name = "${var.project_name}-flow-log-role"
+  assume_role_policy = jsonencode({
+    Version = "2012-10-17",
+    Statement = [{
+      Effect = "Allow",
+      Principal = { Service = "vpc-flow-logs.amazonaws.com" },
+      Action = "sts:AssumeRole"
+    }]
+  })
+}
+
+resource "aws_iam_role_policy_attachment" "flow_log_attach" {
+  role       = aws_iam_role.flow_log_role.name
+  policy_arn = "arn:aws:iam::aws:policy/CloudWatchLogsFullAccess"
+}
