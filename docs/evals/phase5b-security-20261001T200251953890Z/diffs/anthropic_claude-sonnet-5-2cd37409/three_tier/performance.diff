--- /dev/null
+++ b/terraform/s3_alb_logs.tf
@@ -0,0 +1,68 @@
+resource "aws_s3_bucket" "alb_logs" {
+  bucket = "${var.project_name}-alb-logs"
+  acl    = "private"
+
+  force_destroy = true
+
+  tags = {
+    Name = "${var.project_name}-alb-logs"
+  }
+}
+
+# Enable versioning
+resource "aws_s3_bucket_versioning" "alb_logs_versioning" {
+  bucket = aws_s3_bucket.alb_logs.id
+  versioning_configuration {
+    status = "Enabled"
+  }
+}
+
+# Enable server‑side encryption with a customer‑managed KMS key (the key is created elsewhere in the plan)
+resource "aws_s3_bucket_server_side_encryption_configuration" "alb_logs_encryption" {
+  bucket = aws_s3_bucket.alb_logs.id
+
+  rule {
+    apply_server_side_encryption_by_default {
+      kms_master_key_id = aws_kms_key.s3_alb_logs_key.arn
+      sse_algorithm     = "aws:kms"
+    }
+  }
+}
+
+# Public access block – block all public ACLs and policies
+resource "aws_s3_bucket_public_access_block" "alb_logs_public_access" {
+  bucket = aws_s3_bucket.alb_logs.id
+
+  block_public_acls   = true
+  block_public_policy = true
+  ignore_public_acls  = true
+  restrict_public_buckets = true
+}
+
+# Enable access logging – logs are written to the same bucket under a "logs/" prefix
+resource "aws_s3_bucket_logging" "alb_logs_logging" {
+  bucket        = aws_s3_bucket.alb_logs.id
+  target_bucket = aws_s3_bucket.alb_logs.id
+  target_prefix = "logs/"
+}
+
+resource "aws_s3_bucket_policy" "alb_logs_policy" {
+  bucket = aws_s3_bucket.alb_logs.id
+  policy = jsonencode({
+    Version = "2012-10-17"
+    Statement = [{
+      Sid       = "AllowALBLogging"
+      Effect    = "Allow"
+      Principal = { Service = "logging.amazonaws.com" }
+      Action    = "s3:PutObject"
+      Resource  = "${aws_s3_bucket.alb_logs.arn}/*"
+    }]
+  })
+}
+
+# Customer‑managed KMS key for bucket encryption (if not already defined elsewhere)
+resource "aws_kms_key" "s3_alb_logs_key" {
+  description               = "KMS key for ALB logs bucket encryption"
+  deletion_window_in_days   = 30
+  enable_key_rotation       = true
+}
