# Grafana dashboard JSON
{
  "dashboard": {
    "id": null,
    "uid": "default",
    "title": "EKS Overview",
    "timezone": "browser",
    "panels": [
      {
        "type": "graph",
        "title": "CPU Usage",
        "targets": [{
          "expr": "sum(rate(container_cpu_usage_seconds_total[5m]))",
          "legendFormat": "CPU"
        }]
      },
      {
        "type": "graph",
        "title": "Memory Usage",
        "targets": [{
          "expr": "sum(container_memory_working_set_bytes)",
          "legendFormat": "Memory"
        }]
      }
    ],
    "schemaVersion": 30,
    "version": 1
  },
  "overwrite": false
}
