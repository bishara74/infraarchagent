{
  "cloud_provider": "aws",
  "services": [
    {
      "name": "cluster",
      "aws_service": "EKS",
      "purpose": "Run Kubernetes workloads"
    },
    {
      "name": "api",
      "aws_service": "EKS",
      "purpose": "Serve the API"
    },
    {
      "name": "metrics",
      "aws_service": "EKS",
      "purpose": "Collect Prometheus metrics"
    },
    {
      "name": "dashboards",
      "aws_service": "EKS",
      "purpose": "Show Grafana dashboards"
    }
  ],
  "dependencies": [
    {
      "source": "api",
      "target": "cluster",
      "description": "Application traffic"
    },
    {
      "source": "metrics",
      "target": "cluster",
      "description": "Application traffic"
    },
    {
      "source": "dashboards",
      "target": "metrics",
      "description": "Application traffic"
    }
  ],
  "network": {
    "public_services": [
      "api"
    ],
    "private_services": [
      "cluster",
      "metrics",
      "dashboards"
    ],
    "ingress": [
      "HTTPS 443 from internet"
    ],
    "notes": "AWS VPC with private subnets for internal components"
  },
  "storage": [],
  "file_types": [
    "terraform",
    "kubernetes",
    "helm",
    "prometheus",
    "grafana"
  ],
  "ambiguities": []
}
